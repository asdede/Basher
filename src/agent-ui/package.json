{
  "name": "basher-agent-ui",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build": "node --check main.js && node --check preload.js && node --check terminal-pty.js && node --check renderer/renderer.js",
    "ensure-electron": "node scripts/ensure-electron.js",
    "postinstall": "node scripts/ensure-electron.js && (electron-rebuild -f -w node-pty || true)"
  },
  "dependencies": {
    "@electron/rebuild": "^4.0.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^38.8.6",
    "node-pty": "^1.1.0"
  }
}
