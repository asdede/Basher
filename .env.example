# Copy to .env and set your user so the API writes eval/results as you (eval-app can then save scores).
# Or use: ./Scripts/basher.sh --start (it sets UID/GID automatically).
UID=1000
GID=1000

# Official chat/agent model (must be pulled in Ollama; needs "tools" capability).
# Default matches docker-compose / Dockerfile.LLM / API.
OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_NUM_CTX=4096

# Chunking for RAG ingest (when running python -m src.db.init): fixed | semantic | agentic
# CHUNK_STRATEGY=fixed
# CHUNK_SIZE=350
# CHUNK_OVERLAP=60
# SEMANTIC_CHUNK_SIMILARITY=0.5
# SEMANTIC_CHUNK_MIN_WORDS=80
# SEMANTIC_CHUNK_MAX_WORDS=350
# OLLAMA_URL=http://ollama:11434/api/generate   # for agentic chunking
# OLLAMA_CHUNK_MODEL=qwen3.5:4b

# Retrieval tuning (API)
# RAG_PER_COLLECTION_K=4
# RAG_CONTEXT_TOP_N=8
# RAG_MIN_SCORE=0.32
# RAG_MAX_CHUNK_CHARS=1600

# Fedora quick-docs (gitignored under docs/). Fetch before fedora ingest:
#   ./Scripts/fetch-fedora-docs.sh
# Optional override:
# FEDORA_QUICK_DOCS_URL=https://forge.fedoraproject.org/docs/quick-docs.git
